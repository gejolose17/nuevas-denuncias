# ============================================================
# UAM ReportHub - Variables de Entorno para Microsoft Entra ID
# ============================================================

# ID de la aplicación (Cliente) generado en Azure Portal / Microsoft Entra
# Ejemplo: 4a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
VITE_AZURE_CLIENT_ID=tu_client_id_de_azure

# ID del Directorio (Inquilino) o "organizations" para cualquier cuenta profesional/educativa
# Ejemplo: uam.net.ni Tenant ID o "organizations"
VITE_AZURE_TENANT_ID=organizations

# URL de Redirección (Redirect URI) configurada en la plataforma SPA de Azure
# En local: http://localhost:5173
# En Vercel: https://tu-proyecto.vercel.app
VITE_AZURE_REDIRECT_URI=http://localhost:5173

